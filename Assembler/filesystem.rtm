.section ".text"

main:
    addi $sp, $zero, 0x1000         // Stack pointer
    lw   $s0, MMIO_ADDR($zero)      // Consola MMIO (0xFFFFFF00)

    jal  inicializar_fs

    lw   $a0, ptr_msg_welcome($zero)
    jal  imprimir_asciiz

loop_cli:
    // Prompt "fs> "
    addi $t0, $zero, 'f'
    sb   $t0, 0($s0)
    addi $t0, $zero, 's'
    sb   $t0, 0($s0)
    addi $t0, $zero, '>'
    sb   $t0, 0($s0)
    addi $t0, $zero, ' '
    sb   $t0, 0($s0)

    // Leer linea de comando
    lw   $a0, ptr_cmd_buffer($zero)
    addi $a1, $zero, 60
    jal  leer_linea

    // Si buffer vacio, volver al prompt
    lw   $t0, ptr_cmd_buffer($zero)
    lb   $t1, 0($t0)
    beq  $t1, $zero, loop_cli

    jal  parsear_comando

    // Comparar con 'help'
    lw   $a0, ptr_cmd_buffer($zero)
    lw   $a1, ptr_str_help($zero)
    jal  strcmp
    beq  $t5, $zero, cmd_help

    // Comparar con 'ls'
    lw   $a0, ptr_cmd_buffer($zero)
    lw   $a1, ptr_str_ls($zero)
    jal  strcmp
    beq  $t5, $zero, cmd_ls

    // Comparar con 'touch'
    lw   $a0, ptr_cmd_buffer($zero)
    lw   $a1, ptr_str_touch($zero)
    jal  strcmp
    beq  $t5, $zero, cmd_touch

    // Comparar con 'cat'
    lw   $a0, ptr_cmd_buffer($zero)
    lw   $a1, ptr_str_cat($zero)
    jal  strcmp
    beq  $t5, $zero, cmd_cat

    // Comparar con 'write'
    lw   $a0, ptr_cmd_buffer($zero)
    lw   $a1, ptr_str_write($zero)
    jal  strcmp
    beq  $t5, $zero, cmd_write

    // Si no coincidió con ninguno:
    lw   $a0, ptr_msg_unk($zero)
    jal  imprimir_asciiz
    j    loop_cli

// -------------------------------------------------------------
// COMANDOS
// -------------------------------------------------------------
cmd_help:
    lw   $a0, ptr_msg_help($zero)
    jal  imprimir_asciiz
    j    loop_cli

cmd_ls:
    addi $s1, $zero, 0
    lw   $s2, ptr_fs_table($zero)

loop_ls:
    addi $t0, $zero, 4
    beq  $s1, $t0, loop_cli

    sll  $t1, $s1, 4
    add  $s3, $s2, $t1

    lb   $t2, 0($s3)
    beq  $t2, $zero, sig_ls

    addi $t0, $zero, '-'
    sb   $t0, 0($s0)
    addi $t0, $zero, ' '
    sb   $t0, 0($s0)

    add  $a0, $s3, $zero
    jal  imprimir_asciiz

    addi $t0, $zero, ' '
    sb   $t0, 0($s0)
    addi $t0, $zero, '('
    sb   $t0, 0($s0)

    lw   $a0, 12($s3)
    jal  imprimir_numero

    lw   $a0, ptr_msg_bytes($zero)
    jal  imprimir_asciiz

sig_ls:
    addi $s1, $s1, 1
    j    loop_ls

cmd_touch:
    lw   $t0, ptr_arg_buffer($zero)
    lb   $t1, 0($t0)
    bne  $t1, $zero, buscar_libre_touch
    lw   $a0, ptr_msg_noarg($zero)
    jal  imprimir_asciiz
    j    loop_cli

buscar_libre_touch:
    add  $a0, $t0, $zero
    jal  buscar_archivo
    addi $t0, $zero, -1
    bne  $t4, $t0, err_touch_existe

    addi $s1, $zero, 0
    lw   $s2, ptr_fs_table($zero)

loop_slot_touch:
    addi $t0, $zero, 4
    beq  $s1, $t0, err_fs_lleno
    sll  $t1, $s1, 4
    add  $s3, $s2, $t1
    lb   $t2, 0($s3)
    beq  $t2, $zero, copiar_nom_touch
    addi $s1, $s1, 1
    j    loop_slot_touch

copiar_nom_touch:
    lw   $t0, ptr_arg_buffer($zero)
    add  $t1, $s3, $zero
    addi $t3, $zero, 0

loop_cp_t:
    lb   $t2, 0($t0)
    sb   $t2, 0($t1)
    beq  $t2, $zero, fin_cp_touch
    addi $t0, $t0, 1
    addi $t1, $t1, 1
    addi $t3, $t3, 1
    addi $t4, $zero, 7
    blt  $t3, $t4, loop_cp_t
    sb   $zero, 0($t1)

fin_cp_touch:
    sw   $zero, 12($s3)
    lw   $t4, 8($s3)
    sb   $zero, 0($t4)
    j    loop_cli

err_touch_existe:
    lw   $a0, ptr_msg_exist($zero)
    jal  imprimir_asciiz
    j    loop_cli

err_fs_lleno:
    lw   $a0, ptr_msg_full($zero)
    jal  imprimir_asciiz
    j    loop_cli

cmd_cat:
    lw   $t0, ptr_arg_buffer($zero)
    lb   $t1, 0($t0)
    bne  $t1, $zero, buscar_cat
    lw   $a0, ptr_msg_noarg($zero)
    jal  imprimir_asciiz
    j    loop_cli

buscar_cat:
    add  $a0, $t0, $zero
    jal  buscar_archivo
    addi $t0, $zero, -1
    beq  $t4, $t0, err_no_existe

    lw   $s1, 8($t4)
    lw   $s2, 12($t4)
    addi $s3, $zero, 0

loop_print_cat:
    beq  $s3, $s2, fin_print_cat
    lb   $t1, 0($s1)
    sb   $t1, 0($s0)
    addi $s1, $s1, 1
    addi $s3, $s3, 1
    j    loop_print_cat

fin_print_cat:
    addi $t0, $zero, '\r'
    sb   $t0, 0($s0)
    addi $t0, $zero, '\n'
    sb   $t0, 0($s0)
    j    loop_cli

err_no_existe:
    lw   $a0, ptr_msg_notfound($zero)
    jal  imprimir_asciiz
    j    loop_cli

cmd_write:
    lw   $t0, ptr_arg_buffer($zero)
    lb   $t1, 0($t0)
    bne  $t1, $zero, buscar_wr
    lw   $a0, ptr_msg_noarg($zero)
    jal  imprimir_asciiz
    j    loop_cli

buscar_wr:
    add  $a0, $t0, $zero
    jal  buscar_archivo
    addi $t0, $zero, -1
    beq  $t4, $t0, err_no_existe

    add  $s4, $t4, $zero
    lw   $s1, 8($s4)                // Base del bloque
    add  $s2, $s1, $zero            // Puntero de escritura actual
    addi $s3, $zero, 0              // Contador de bytes
    addi $t5, $zero, 127            // Máximo permitido

    lw   $a0, ptr_msg_wr_info($zero)
    jal  imprimir_asciiz

loop_wr_tecla:
    lb   $t0, 0($s0)
    beq  $t0, $zero, loop_wr_tecla

    addi $t1, $zero, 27             // ESC
    beq  $t0, $t1, fin_wr

    addi $t1, $zero, 10             // LF
    beq  $t0, $t1, wr_enter
    addi $t1, $zero, 13             // CR
    beq  $t0, $t1, wr_enter

    addi $t1, $zero, 8              // Backspace
    beq  $t0, $t1, wr_bs
    addi $t1, $zero, 127
    beq  $t0, $t1, wr_bs

    beq  $s3, $t5, loop_wr_tecla

    sb   $t0, 0($s2)
    sb   $t0, 0($s0)
    addi $s2, $s2, 1
    addi $s3, $s3, 1
    j    loop_wr_tecla

wr_enter:
    beq  $s3, $t5, loop_wr_tecla
    addi $t2, $zero, '\n'
    sb   $t2, 0($s2)
    addi $s2, $s2, 1
    addi $s3, $s3, 1
    addi $t0, $zero, '\r'
    sb   $t0, 0($s0)
    addi $t0, $zero, '\n'
    sb   $t0, 0($s0)
    j    loop_wr_tecla

wr_bs:
    beq  $s3, $zero, loop_wr_tecla
    addi $s2, $s2, -1
    addi $s3, $s3, -1
    addi $t2, $zero, 8
    sb   $t2, 0($s0)
    addi $t2, $zero, ' '
    sb   $t2, 0($s0)
    addi $t2, $zero, 8
    sb   $t2, 0($s0)
    j    loop_wr_tecla

fin_wr:
    sw   $s3, 12($s4)               // Guardar tamaño
    sb   $zero, 0($s2)              // Terminador nulo
    addi $t0, $zero, '\r'
    sb   $t0, 0($s0)
    addi $t0, $zero, '\n'
    sb   $t0, 0($s0)
    j    loop_cli

// -------------------------------------------------------------
// SUBRUTINAS
// -------------------------------------------------------------
inicializar_fs:
    lw   $t0, ptr_fs_table($zero)
    lw   $t1, ptr_blk_0($zero)
    sw   $t1, 8($t0)
    lw   $t1, ptr_blk_1($zero)
    sw   $t1, 24($t0)
    lw   $t1, ptr_blk_2($zero)
    sw   $t1, 40($t0)
    lw   $t1, ptr_blk_3($zero)
    sw   $t1, 56($t0)
    jr   $ra, 0

buscar_archivo:
    addi $sp, $sp, -12
    sw   $ra, 0($sp)
    sw   $s1, 4($sp)
    sw   $s5, 8($sp)

    add  $s1, $a0, $zero
    addi $s5, $zero, 0
    lw   $s3, ptr_fs_table($zero)

loop_busq:
    addi $t0, $zero, 4
    beq  $s5, $t0, not_found_f
    sll  $t1, $s5, 4
    add  $s4, $s3, $t1
    lb   $t2, 0($s4)
    beq  $t2, $zero, sig_busq

    add  $a0, $s1, $zero
    add  $a1, $s4, $zero
    jal  strcmp
    beq  $t5, $zero, found_f

sig_busq:
    addi $s5, $s5, 1
    j    loop_busq

found_f:
    add  $t4, $s4, $zero
    j    end_busq

not_found_f:
    addi $t4, $zero, -1

end_busq:
    lw   $ra, 0($sp)
    lw   $s1, 4($sp)
    lw   $s5, 8($sp)
    addi $sp, $sp, 12
    jr   $ra, 0

parsear_comando:
    lw   $t0, ptr_cmd_buffer($zero)
    lw   $t1, ptr_arg_buffer($zero)
    sb   $zero, 0($t1)

loop_p_esp:
    lb   $t2, 0($t0)
    beq  $t2, $zero, fin_p
    addi $t3, $zero, ' '
    beq  $t2, $t3, split_cmd
    addi $t3, $zero, 13             // Limpiar si vino con \r
    beq  $t2, $t3, split_cmd
    addi $t3, $zero, 10             // Limpiar si vino con \n
    beq  $t2, $t3, split_cmd
    addi $t0, $t0, 1
    j    loop_p_esp

split_cmd:
    sb   $zero, 0($t0)
    addi $t0, $t0, 1

loop_omitir_e:
    lb   $t2, 0($t0)
    beq  $t2, $zero, fin_p
    addi $t3, $zero, ' '
    bne  $t2, $t3, copiar_p_arg
    addi $t0, $t0, 1
    j    loop_omitir_e

copiar_p_arg:
    lb   $t2, 0($t0)
    beq  $t2, $zero, fin_p_arg
    addi $t3, $zero, 13
    beq  $t2, $t3, fin_p_arg
    addi $t3, $zero, 10
    beq  $t2, $t3, fin_p_arg
    sb   $t2, 0($t1)
    addi $t0, $t0, 1
    addi $t1, $t1, 1
    j    copiar_p_arg

fin_p_arg:
    sb   $zero, 0($t1)
fin_p:
    jr   $ra, 0

leer_linea:
    add  $t1, $a0, $zero            // t1 apunta directamente al buffer
    addi $t4, $zero, 0              // t4 = contador de caracteres

loop_leer_c:
    lb   $t2, 0($s0)
    beq  $t2, $zero, loop_leer_c

    addi $t3, $zero, 13             // Enter CR
    beq  $t2, $t3, fin_leer_enter
    addi $t3, $zero, 10             // Enter LF
    beq  $t2, $t3, fin_leer_enter

    addi $t3, $zero, 8              // Backspace
    beq  $t2, $t3, bs_leer_c
    addi $t3, $zero, 127
    beq  $t2, $t3, bs_leer_c

    addi $t3, $zero, 32             // Ignora caracteres de control
    blt  $t2, $t3, loop_leer_c

    beq  $t4, $a1, loop_leer_c

    sb   $t2, 0($t1)
    sb   $t2, 0($s0)
    addi $t1, $t1, 1
    addi $t4, $t4, 1
    j    loop_leer_c

bs_leer_c:
    beq  $t4, $zero, loop_leer_c
    addi $t1, $t1, -1
    addi $t4, $t4, -1
    addi $t3, $zero, 8
    sb   $t3, 0($s0)
    addi $t3, $zero, ' '
    sb   $t3, 0($s0)
    addi $t3, $zero, 8
    sb   $t3, 0($s0)
    j    loop_leer_c

fin_leer_enter:
    sb   $zero, 0($t1)              // Cierra con \0
    addi $t0, $zero, '\r'
    sb   $t0, 0($s0)
    addi $t0, $zero, '\n'
    sb   $t0, 0($s0)
    jr   $ra, 0

// strcmp: Compara cadenas en $a0 y $a1
// Retorna en $t5: 0 si son IGUALES, 1 si son DISTINTAS
strcmp:
    add  $t0, $a0, $zero
    add  $t1, $a1, $zero

loop_sc:
    lb   $t2, 0($t0)
    lb   $t3, 0($t1)
    bne  $t2, $t3, sc_dif
    beq  $t2, $zero, sc_eq
    addi $t0, $t0, 1
    addi $t1, $t1, 1
    j    loop_sc

sc_dif:
    addi $t5, $zero, 1
    jr   $ra, 0

sc_eq:
    addi $t5, $zero, 0
    jr   $ra, 0

imprimir_asciiz:
    add  $t0, $a0, $zero
loop_prt:
    lb   $t1, 0($t0)
    beq  $t1, $zero, fin_prt
    sb   $t1, 0($s0)
    addi $t0, $t0, 1
    j    loop_prt
fin_prt:
    jr   $ra, 0

imprimir_numero:
    addi $t1, $zero, 10
    div  $t2, $a0, $t1
    rest $t3, $a0, $t1
    beq  $t2, $zero, solo_un_digito

    addi $t4, $t2, 48
    sb   $t4, 0($s0)

solo_un_digito:
    addi $t3, $t3, 48
    sb   $t3, 0($s0)
    jr   $ra, 0

// -------------------------------------------------------------
// SECCION DE DATOS
// -------------------------------------------------------------
.section ".data"

.pad 0(4)
MMIO_ADDR:       .word 0xFFFFFF00

.pad 0(4)
ptr_cmd_buffer:  .ptr cmd_buffer
ptr_arg_buffer:  .ptr arg_buffer
ptr_fs_table:    .ptr fs_table
ptr_blk_0:       .ptr blk_data_0
ptr_blk_1:       .ptr blk_data_1
ptr_blk_2:       .ptr blk_data_2
ptr_blk_3:       .ptr blk_data_3

ptr_str_help:    .ptr str_help
ptr_str_ls:      .ptr str_ls
ptr_str_touch:   .ptr str_touch
ptr_str_cat:     .ptr str_cat
ptr_str_write:   .ptr str_write

ptr_msg_welcome: .ptr msg_welcome
ptr_msg_help:    .ptr msg_help
ptr_msg_bytes:   .ptr msg_bytes
ptr_msg_noarg:   .ptr msg_noarg
ptr_msg_exist:   .ptr msg_exist
ptr_msg_full:    .ptr msg_full
ptr_msg_notfound:.ptr msg_notfound
ptr_msg_wr_info: .ptr msg_wr_info
ptr_msg_unk:     .ptr msg_unk

msg_welcome:     .asciiz "=== RTM32 Flat File System ===\r\nEscribi 'help'\r\n"
msg_help:        .asciiz "Comandos:\r\n  ls              Listar archivos\r\n  touch <nom>     Crear archivo vacio\r\n  write <nom>     Editar archivo (ESC para guardar)\r\n  cat <nom>       Ver contenido\r\n  help            Ayuda\r\n"
msg_bytes:       .asciiz " bytes)\r\n"
msg_noarg:       .asciiz "Error: falta indicar nombre de archivo\r\n"
msg_exist:       .asciiz "Error: ya existe un archivo con ese nombre\r\n"
msg_full:        .asciiz "Error: tabla de archivos llena (max 4)\r\n"
msg_notfound:    .asciiz "Error: archivo no encontrado\r\n"
msg_wr_info:     .asciiz "Escribi el texto (presiona ESC para salir y guardar):\r\n"
msg_unk:         .asciiz "Comando desconocido. Escribi 'help'\r\n"

str_help:        .asciiz "help"
str_ls:          .asciiz "ls"
str_touch:       .asciiz "touch"
str_cat:         .asciiz "cat"
str_write:       .asciiz "write"

.pad 0(4)
cmd_buffer:      .pad 64
arg_buffer:      .pad 64

.pad 0(4)
fs_table:
    // Slot 0: "readme\0\0" (8 bytes exactos)
    .byte 'r' 'e' 'a' 'd' 'm' 'e' 0 0
    .word 0
    .word 34

    // Slot 1
    .pad 8
    .word 0
    .word 0

    // Slot 2
    .pad 8
    .word 0
    .word 0

    // Slot 3
    .pad 8
    .word 0
    .word 0

.pad 0(4)
blk_data_0:      .asciiz "Bienvenido al filesystem de RTM32!"
                 .pad 93

.pad 0(4)
blk_data_1:      .pad 128

.pad 0(4)
blk_data_2:      .pad 128

.pad 0(4)
blk_data_3:      .pad 128
